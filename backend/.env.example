# Copy to .env and fill from `supabase start` output + your OpenAI key
PORT=8080
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=<service_role key from `supabase start`>
SUPABASE_JWT_SECRET=<JWT secret from `supabase start`>
OPENAI_API_KEY=<your OpenAI key>
# Encrypts users' bring-your-own provider API keys at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=<base64 of 32 random bytes>
# LANGSMITH_API_KEY=  # deferred (Phase 7 add-on)
CORS_ORIGIN=http://localhost:3000
